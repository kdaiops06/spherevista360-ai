# SphereVista360 Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI APIs
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Financial Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
EXCHANGERATE_API_KEY=your_exchangerate_api_key
FRED_API_KEY=your_fred_api_key
FINNHUB_API_KEY=your_finnhub_api_key
TWELVEDATA_API_KEY=your_twelvedata_api_key
POLYGON_API_KEY=your_polygon_api_key

# Watchlist AI module controls
WATCHLIST_AI_CACHE_TTL_SECONDS=45
WATCHLIST_AI_POLL_INTERVAL_SECONDS=20
WATCHLIST_AI_REQUEST_TIMEOUT_MS=7000
WATCHLIST_AI_RETRY_ATTEMPTS=2
WATCHLIST_AI_MAX_REQUESTS_PER_MINUTE=80
WATCHLIST_AI_ALERT_DROP_THRESHOLD=3.5
WATCHLIST_AI_ALERT_VOLATILITY_THRESHOLD=72
WATCHLIST_AI_ALERT_VOLUME_SPIKE_RATIO=1.7
NEXT_PUBLIC_WATCHLIST_AI_STREAM=0

# News APIs
NEWS_API_KEY=your_news_api_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Site Config
NEXT_PUBLIC_SITE_URL=https://spherevista360.com
NEXT_PUBLIC_SITE_NAME=SphereVista360

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=your_adsense_client_id
